// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id          String @id @default(uuid())

  userId      String

  user        User @relation(fields:[userId], references:[id])

  userAgent   String?

  ipAddress   String?

  startedAt   DateTime @default(now())

  endedAt     DateTime?

  telemetry   Telemetry[]

  features    Feature[]

  riskScores  RiskScore[]

  predictions Prediction[]

  decisionLogs DecisionLog[]
}

model Telemetry {
  id          String @id @default(uuid())

  sessionId   String

  session     Session @relation(fields:[sessionId], references:[id])

  eventType   String

  payload     Json

  createdAt   DateTime @default(now())
}

model Prediction {
  id               String @id @default(uuid())

  sessionId        String

  session          Session @relation(fields:[sessionId], references:[id])

  featureId        String?

  feature          Feature? @relation(fields:[featureId], references:[id])

  modelName        String

  fraudProbability Float

  anomalyScore     Float?

  reasons          Json?

  createdAt        DateTime @default(now())

  riskScores       RiskScore[]

  decisionLogs     DecisionLog[]
}

model Feature {
  id                String @id @default(uuid())

  sessionId         String

  session           Session @relation(fields:[sessionId], references:[id])

  avgDwellTime      Float?

  avgFlightTime     Float?

  avgMouseSpeed     Float?

  avgMouseAcceleration Float?

  clickFrequency    Float?

  avgScrollRate     Float?

  idleTime          Float?

  typingSpeed       Float?

  createdAt         DateTime @default(now())

  predictions       Prediction[]
}

model RiskScore {
  id          String @id @default(uuid())

  sessionId   String

  session     Session @relation(fields:[sessionId], references:[id])

  predictionId String?

  prediction   Prediction? @relation(fields:[predictionId], references:[id])

  score       Float

  level       String

  createdAt   DateTime @default(now())

  decisionLogs DecisionLog[]
}

model DecisionLog {
  id           String @id @default(uuid())

  sessionId    String

  session      Session @relation(fields:[sessionId], references:[id])

  predictionId String?

  prediction   Prediction? @relation(fields:[predictionId], references:[id])

  riskScoreId  String?

  riskScore    RiskScore? @relation(fields:[riskScoreId], references:[id])

  decision     String

  reason       String?

  createdAt    DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions     Session[]
}
